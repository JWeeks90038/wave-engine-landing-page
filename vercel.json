{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/artist-profile.js": {
      "includeFiles": "artist.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap-artists.xml",
      "destination": "/api/artist-profile?sitemap=index"
    },
    {
      "source": "/sitemap-artists-:part(\\d+).xml",
      "destination": "/api/artist-profile?sitemap=:part"
    },
    {
      "source": "/artist/:slug",
      "destination": "/api/artist-profile?page=1&slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
